# HacKU Time-Grocer — example environment
# Copy to .env and adjust locally. Never commit real secrets.

MOCK_API_HOST=0.0.0.0
MOCK_API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=dev
OFFLINE_MODE=true

# Durable stores (persistance/ — Postgres audit + Redis escalation TTL)
# Start with: cd persistance && docker compose up -d
DATABASE_URL=postgresql://tg:tg@127.0.0.1:5432/time_grocer
REDIS_URL=redis://127.0.0.1:6379/0
PERSISTANCE_PORT=8003
POLICY_API_PORT=8001
ESCALATION_TTL_SECONDS=600
