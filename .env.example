# HacKU Time-Grocer — example environment
# Copy to .env and adjust locally. Never commit real secrets.

MOCK_API_HOST=0.0.0.0
MOCK_API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=dev
OFFLINE_MODE=true

# Durable stores. Host MySQL listens on port 3306.
# persistance tests use database time_grocer_test and must not truncate this one.
DATABASE_URL=mysql://tg:tg@127.0.0.1:3306/time_grocer
REDIS_URL=redis://127.0.0.1:6379/0
PERSISTANCE_PORT=8003
PERSISTANCE_API_BASE_URL=http://127.0.0.1:8003
ACCOUNT_ID=demo
POLICY_API_PORT=8001
ESCALATION_TTL_SECONDS=600
