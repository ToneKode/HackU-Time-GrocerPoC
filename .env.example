# HacKU Time-Grocer — example environment
# Copy to .env and adjust locally. Never commit real secrets.

MOCK_API_HOST=0.0.0.0
MOCK_API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=dev
OFFLINE_MODE=true

# Person 2 / infra — Postgres + Redis
POSTGRES_DB=timegrocer
POSTGRES_USER=timegrocer
POSTGRES_PASSWORD=timegrocer
POSTGRES_PORT=5432
DATABASE_URL=postgresql://timegrocer:timegrocer@127.0.0.1:5432/timegrocer
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
POLICY_API_PORT=8001
