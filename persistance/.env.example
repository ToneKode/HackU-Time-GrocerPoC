# Copy to persistance/.env (or export in the shell). Never commit real secrets.

# Host MySQL on port 3306. Tests use time_grocer_test on the same server.
DATABASE_URL=mysql://tg:tg@127.0.0.1:3306/time_grocer

# Redis — escalation TTL clock (600 s by default)
REDIS_URL=redis://127.0.0.1:6379/0

# Persistence API
PERSISTANCE_PORT=8003
FRONTEND_ORIGIN=http://localhost:5173
DEMO_MODE=true
ESCALATION_TTL_SECONDS=600
APPROVAL_SIGNING_SECRET=dev-secret-change-me
REQUIRE_SIGNATURE=false
